# Only the values you have to supply. Everything else has a working default;
# the README's environment table lists those.
#
# Nothing reads a .env at the repository root. The API runs inside Next.js,
# so everything the app reads goes in client/.env, the file Next loads.
# server/.env is for what runs from server/: `bun run db:migrate`, which
# needs only MIGRATION_DATABASE_URL, and `bun run dev:server`, the API on
# its own, which needs the same values as client/.env (set API_URL in
# client/.env to send the app's calls to it).
# On Vercel, set these per environment (Production and Preview); the
# README's Production section lists the values that differ.

# Postgres. `docker compose up -d` starts the one this points at. On Vercel
# it is Supabase's transaction pooler (:6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/temply
# server/.env only: where `bun run db:migrate` creates and updates the
# tables. Locally the same database; in CI, Supabase's session pooler (:5432).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/temply

# Clerk — the secret verifies sessions; the publishable key is needed when a
# session token is presented to the API directly.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Our own sign-in and sign-up pages. Without these Clerk sends people to
# its hosted portal on another domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shared secret proving the Next.js proxy to the API. The API only honours a
# forwarded `x-user-id` when the caller also presents this value as
# `x-internal-token` (server/src/plugins/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# The site's own address — links, webhooks, docs snippets and the legal
# pages all print it (shared/site.ts). For a public dev preview point it at
# a cloudflared tunnel to :9000 (see the README).
NEXT_PUBLIC_APP_URL=http://localhost:9000
# The canonical host search engines and share cards name, whatever host a
# preview is served from. Set it when the domain moves.
# NEXT_PUBLIC_SITE_URL=https://temply.example
# Mail addresses. Each one unset is derived from the site's host
# (hello@, sales@, send@ the hostname), so nothing is ever sent from a
# domain that is not yours. The contact form sends from CONTACT_FROM_EMAIL,
# or from the sending address when that is unset.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@temply.example
# NEXT_PUBLIC_SALES_EMAIL=sales@temply.example
# SENDING_FROM_ADDRESS=send@temply.example
# SENDING_FROM_LABEL=Temply
# CONTACT_FROM_EMAIL=

# Clerk webhook — register <app url>/api/webhooks/clerk for
# organization.deleted, user.deleted, organizationMembership.created and
# organizationMembership.deleted. A deleted workspace is purged and its
# Stripe subscription cancelled; a member joining or leaving changes the
# subscription's seats (server/src/routes/webhooks/clerk.ts).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Stripe — processes payments for the Team plan; Temply is the seller.
# Register <app url>/api/webhooks/stripe for customer.subscription.created,
# customer.subscription.updated and customer.subscription.deleted, and put
# that endpoint's signing secret here. `bun run dev:public` registers the
# endpoint for you and writes the secret when it creates one.
# The three prices are monthly: the seat (licensed, $5 a unit), the API
# overage (usage-based on the meter below, 0.1 cents a unit, so $1 per
# 1,000 calls) and the template pack (licensed, $5 a unit). The meter sums
# the payload key `value` per `stripe_customer_id`. Billing stays off until
# the key and all three prices are set; the README's Setup has the rest.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT=
STRIPE_PRICE_API_OVERAGE=
STRIPE_PRICE_TEMPLATE_PACK=
# STRIPE_METER_EVENT=temply_api_calls

# Vercel Cron sends this as a bearer token when it asks for the overage
# report; without it the cron route refuses (server/src/routes/cron.ts).
# Production only, since Vercel runs crons only there. Locally, the
# standalone API reports on its own timer instead.
# CRON_SECRET=

# Resend — every email the app sends. The contact form stores each message
# either way, and delivers it to CONTACT_EMAIL only when both are set.
RESEND_API_KEY=
CONTACT_EMAIL=

# ImageKit — image uploads. The browser sends the file to the API, which
# passes it on, so all three stay on the server.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Error monitoring — optional; unset means nothing is reported.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
