# Nothing reads a .env at the repository root. Next.js loads client/.env and
# the API server, started from server/, loads server/.env — copy each block
# below into the file named above it. Where a key appears in both blocks the
# two copies must hold the same value.
# On Railway, combine both blocks into one service variable set. The image
# uses PORT=8080, SQLITE_DB_PATH=/data/maily.db and BACKUP_DIR=/data/backups;
# keep those production paths instead of the local defaults below.

# ---------------------------------------------------------------- client/.env

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Our own sign-in and sign-up pages. Without these Clerk sends people to
# its hosted portal on another domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shared secret proving the Next.js proxy to the API server. The API only
# honours a forwarded `x-user-id` when the caller also presents this value as
# `x-internal-token` (server/src/plugins/auth.ts). Must be identical in
# client/.env and server/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Where Next.js reaches the API server. Leave unset in development: it
# defaults to the API on this machine (client/lib/api-target.ts).
# API_URL=https://api.example.com

# The site's own address — metadata, sitemap, docs snippets and the legal
# pages all print it (client/lib/site.ts), and next.config allows it as a dev
# origin. Must equal the server's copy. For a public dev preview point it at
# a cloudflared tunnel to :9000 (`cloudflared tunnel --url http://localhost:9000`)
# and register both webhooks at <this url>/api/webhooks/{clerk,stripe}.
NEXT_PUBLIC_APP_URL=http://localhost:9000
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_SALES_EMAIL=sales@example.com

# Error monitoring — leave unset and nothing is reported. NEXT_PUBLIC_ reaches
# the browser bundle; the server-side runtimes read SENTRY_DSN first. SENTRY_ORG,
# SENTRY_PROJECT and SENTRY_AUTH_TOKEN are build-time only, for source maps.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------- server/.env

# Clerk Auth — the secret verifies sessions; the publishable key is needed
# when a session token is presented to the API directly
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Same value as in client/.env
INTERNAL_API_SECRET=

# Clerk webhook — register https://<api host>/api/webhooks/clerk in the Clerk
# dashboard for organization.deleted and user.deleted. A deleted workspace is
# purged and its Stripe subscription cancelled (server/src/routes/webhooks/clerk.ts).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Database — SQLite, created on first run by server/src/plugins/db.ts
SQLITE_DB_PATH=maily.db
# Snapshots: `bun run db:backup` writes BACKUP_DIR/temply-<stamp>.db and keeps
# the newest BACKUP_KEEP (server/scripts/backup-db.ts). Run it from cron and
# ship the directory off the machine; litestream.yml is the continuous option.
# Railway: enable scheduled volume backups in the service Backups tab.
BACKUP_DIR=backups
BACKUP_KEEP=48

# Error monitoring — unset means nothing is reported.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Stripe
STRIPE_SECRET_KEY=sk_test_...  # From Stripe Dashboard → API keys
STRIPE_WEBHOOK_SECRET=whsec_...  # From Stripe Dashboard → Webhooks

# The Pro plan's recurring price — read as STRIPE_PRICE_<PLAN> in
# server/src/routes/billing.ts. Pro is the only plan Checkout sells;
# Enterprise is arranged by hand. Register the webhook at
# https://<api host>/api/webhooks/stripe for checkout.session.completed,
# customer.subscription.updated and customer.subscription.deleted, and create
# a Customer Portal configuration (the portal route needs a default one).
STRIPE_PRICE_PRO=price_...

# Public app URL — absolute image URLs in rendered email and Stripe return
# URLs are built from it. Same value as in client/.env.
NEXT_PUBLIC_APP_URL=http://localhost:9000

# Temply's own Resend account — all built-in sends go through this key.
RESEND_API_KEY=

# Contact form — where submissions are delivered. Sending is skipped (but
# messages are still stored in contact_messages) when either RESEND_API_KEY
# or CONTACT_EMAIL is missing.
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
# The verified sender the app sends from. Users set a display name only.
SENDING_FROM_ADDRESS=send@temply.app
SENDING_FROM_LABEL=Temply

# ImageKit — image uploads. Private key stays server-side; public key +
# endpoint are handed to the browser to upload directly.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
