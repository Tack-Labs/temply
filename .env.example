# Only the values you have to supply. Everything else has a working default;
# the README's environment table lists those.
#
# Nothing reads a .env at the repository root. Next.js loads client/.env and
# the API server, started from server/, loads server/.env — copy each block
# below into the file named above it. Where a key appears in both blocks the
# two copies must hold the same value.
# On Railway, combine both blocks into one service variable set. The image
# already sets PORT=8080, SQLITE_DB_PATH=/data/maily.db and
# BACKUP_DIR=/data/backups; don't override them.

# ---------------------------------------------------------------- client/.env

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Our own sign-in and sign-up pages. Without these Clerk sends people to
# its hosted portal on another domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shared secret proving the Next.js proxy to the API server. The API only
# honours a forwarded `x-user-id` when the caller also presents this value as
# `x-internal-token` (server/src/plugins/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# The site's own address — metadata, sitemap, docs snippets and the legal
# pages all print it (client/lib/site.ts). For a public dev preview point it
# at a cloudflared tunnel to :9000 (see the README).
NEXT_PUBLIC_APP_URL=http://localhost:9000

# Error monitoring — optional; unset means nothing is reported.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# ---------------------------------------------------------------- server/.env

# Clerk — the secret verifies sessions; the publishable key is needed when a
# session token is presented to the API directly.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
INTERNAL_API_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:9000

# Clerk webhook — register <app url>/api/webhooks/clerk for
# organization.deleted and user.deleted. A deleted workspace is purged and
# its Stripe subscription cancelled (server/src/routes/webhooks/clerk.ts).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Stripe — register <app url>/api/webhooks/stripe for
# checkout.session.completed, customer.subscription.updated and
# customer.subscription.deleted, and create a default Customer Portal
# configuration. STRIPE_PRICE_PRO is the Pro plan's recurring price, the only
# plan Checkout sells.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...

# Resend — every email the app sends. The contact form stores each message
# either way, and delivers it to CONTACT_EMAIL only when both are set.
RESEND_API_KEY=
CONTACT_EMAIL=

# ImageKit — image uploads. The private key stays on the server; the public
# key and endpoint are handed to the browser, which uploads directly.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Error monitoring — optional; unset means nothing is reported.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
