{
  "name": "temply",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:client & wait",
    "dev:public": "bun run scripts/dev-public.ts",
    "dev:client": "bun run --filter @temply/client dev",
    "dev:server": "bun run --filter @temply/server dev",
    "build": "bun run --filter @temply/server build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "e2e": "bun run --filter @temply/e2e test",
    "e2e:ui": "bun run --filter @temply/e2e ui"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "uuid": "^11.1.1"
  }
}
